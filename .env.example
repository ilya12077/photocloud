# Photocloud — пример настроек. Скопируй в .env (python -m app сделает это сам при первом запуске).
# .env в .gitignore: реальные адреса, домены, пароли и токены в репозиторий не попадают.
# Значения пишутся как есть, без кавычек и экранирования. Комментарии — только отдельной строкой.

# ---------- Откуда брать файлы ----------
# local — ТЕСТ: папка на этом компьютере (в проде режим будет удалён)
# smb   — шара Windows по сети (боевой режим)
STORAGE=local
LOCAL_ROOT=D:\Photos

#SMB_HOST=192.168.0.10
#SMB_SHARE=Photos
#SMB_SUBDIR=
#SMB_USER=photoviewer
#SMB_PASSWORD=
#SMB_ENCRYPT=true

# ---------- Веб ----------
# 127.0.0.1 — только с этого компа; 0.0.0.0 — пустить устройства из домашней сети (http, без шифрования!)
BIND=127.0.0.1
PORT=8099
# false только для теста по http. За nginx с https — true.
COOKIE_SECURE=false
# Внешний адрес сайта (нужен для входа через Google). Для теста: http://localhost:8099
#PUBLIC_URL=https://photos.example.com
# За nginx: адрес(а) прокси; только им верим X-Real-IP / X-Forwarded-For.
# Если задано — запросы мимо прокси получают 403 (REQUIRE_PROXY=false отключает).
#TRUSTED_PROXIES=172.30.32.0/23
#ALLOWED_ORIGINS=https://photos.example.com

# Пользователи, сессии, кэш дат, журнал — здесь (по умолчанию ./data)
#DATA_DIR=
# Часовой пояс для EXIF без смещения
TIMEZONE=Europe/Moscow

# ---------- Вход через Google (необязательно) ----------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ---------- Home Assistant ----------
# Long-lived token: профиль HA -> Безопасность -> Долгосрочные токены доступа
#HA_URL=http://127.0.0.1:8123
#HA_TOKEN=
#HA_VERIFY_SSL=true
# Пробуждение ПК (для STORAGE=smb обязательно) — твой скрипт в HA:
#HA_WAKE_SERVICE=script.wake_pc
#WAKE_TIMEOUT=180
# Уведомления на телефон (сервис приложения HA Companion):
#HA_NOTIFY_SERVICE=notify.mobile_app_phone
# События: login, login_new_ip, login_failed, lockout, wake, wake_timeout, index_error
#NOTIFY_EVENTS=login_new_ip,login_failed,lockout,wake_timeout,index_error
# (название, уведомления, сервисы HA и таймауты можно менять и в /admin)

# ---------- Производительность и трафик ----------
# webp заметно легче jpeg — важно для медленного интернета
#IMAGE_FORMAT=webp
#THUMB_SMALL_SIZE=240
#THUMB_SIZE=400
#THUMB_LARGE_SIZE=900
#THUMB_QUALITY=60
# быстрая сильно сжатая версия, которая показывается в просмотре первой
#PREVIEW_QUICK_SIZE=720
#PREVIEW_QUICK_QUALITY=32
#PREVIEW_SIZE=2048
#PREVIEW_QUALITY=72
#THUMB_CACHE_MB=128
#PREVIEW_CACHE_MB=64
# потоков для эскизов; по умолчанию ядер + 1 (на 4 ядрах — 5)
#WORKERS=5
# потоков для чтения дат съёмки (с ПК всё равно не больше 4 одновременно)
#META_THREADS=4
#INDEX_TTL=600
#SESSION_IDLE_HOURS=168
#SESSION_MAX_HOURS=720
# путь к ffmpeg, если не устраивает встроенный из пакета imageio-ffmpeg
#FFMPEG=

# ---------- Видео ----------
# Перекодирование при просмотре (H.264, куски по 4 с, только в RAM — на диск ничего не пишется).
# Качество: 720p, ~1 Мбит/с. В просмотре есть галочка «Оригинал» — исходный файл без пережатия.
#TRANSCODE=true
#TRANSCODE_CACHE_MB=256
# сколько роликов перекодировать одновременно (видео и ролики живых фото)
#TRANSCODE_SLOTS=2
